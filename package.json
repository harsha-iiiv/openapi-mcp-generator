{
  "name": "openapi-mcp-generator",
  "version": "4.2.0",
  "description": "Generates MCP server code from OpenAPI specifications",
  "license": "MIT",
  "author": "Harsha",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "openapi-mcp-generator": "./bin/openapi-mcp-generator.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "bin",
    "playground",
    "README.md",
    "LICENSE"
  ],
  "types": "./dist/index.d.ts",
  "scripts": {
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "format.check": "prettier --check .",
    "format.write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc && chmod 755 dist/index.js bin/openapi-mcp-generator.js",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "keywords": [
    "openapi",
    "mcp",
    "model-context-protocol",
    "generator",
    "llm",
    "ai",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harsha-iiiv/openapi-mcp-generator.git"
  },
  "bugs": {
    "url": "https://github.com/harsha-iiiv/openapi-mcp-generator/issues"
  },
  "homepage": "https://github.com/harsha-iiiv/openapi-mcp-generator#readme",
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "commander": "^15.0.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^22.17.2",
    "@types/uuid": "^10.0.0",
    "axios": "^1.20.0",
    "dotenv": "^16.6.1",
    "hono": "^4.13.13",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "uuid": "^11.1.1",
    "vitest": "^2.1.9"
  }
}
